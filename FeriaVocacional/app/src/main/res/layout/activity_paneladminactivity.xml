<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7E7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUBE TOYS"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="#000000"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel de Administración"
            android:textStyle="bold"
            android:textColor="#444444"
            android:textSize="22sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/txtBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Bienvenido!"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#CE93D8"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestiona tu tienda de forma sencilla."
            android:textSize="16sp"
            android:textColor="#777777"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/btnProductos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Gestionar Productos"
            android:textSize="18sp"
            android:backgroundTint="#CE93D8"
            android:textColor="@android:color/white"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnClientes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Gestionar Clientes"
            android:textSize="18sp"
            android:backgroundTint="#CE93D8"
            android:textColor="@android:color/white"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnCarrito"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Carrito"
            android:textSize="18sp"
            android:backgroundTint="#CE93D8"
            android:textColor="@android:color/white"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnConfiguracion"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Configuración"
            android:textSize="18sp"
            android:backgroundTint="#CE93D8"
            android:textColor="@android:color/white"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Cerrar Sesión"
            android:textSize="18sp"
            android:backgroundTint="#C77DFF"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</ScrollView>